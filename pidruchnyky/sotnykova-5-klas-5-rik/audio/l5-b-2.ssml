<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Szene eins.<break time="600ms"/></prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Guten Tag! Was wünschen Sie?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Ich suche eine Hose für meinen Sohn. Er ist acht.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Welche Größe hat er?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Hundertachtundzwanzig.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Diese hier in Blau ist sehr beliebt. Sie kostet fünfundzwanzig Euro.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Gut, die nehme ich.<break time="1200ms"/>Szene zwei.<break time="600ms"/></prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="-6%">Schau mal, dieses Sofa! Wie findest du es?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="-6%">Zu groß für unser Wohnzimmer. Aber jener Sessel dort ist schön.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="-6%">Welcher? Der grüne?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="-6%">Ja, genau!</prosody><prosody rate="-8%"><break time="1200ms"/>Szene drei.<break time="600ms"/></prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+15%">Mia, welches Spiel kaufen wir für Paul?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+12%">Vielleicht dieses Brettspiel? Paul spielt so gern.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+15%">Was kostet es?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+12%">Zwanzig Euro. Aber wir haben zusammen nur achtzehn.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+15%">Hm. Dann nehmen wir jenes Puzzle für fünfzehn Euro.</prosody></voice>
</speak>
