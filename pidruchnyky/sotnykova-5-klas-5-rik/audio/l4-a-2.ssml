<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Anna, unsere Klasse macht eine Faschingsparty! Wann machen wir sie?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Am Donnerstag, am zwölften Februar. Da haben wir nur vier Stunden.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Gute Idee! Und wo?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">In der Aula. Frau Lang hat schon Ja gesagt.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Super! Welches Kostüm trägst du?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Ich gehe als Hexe. Und du?</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Ich weiß noch nicht. Vielleicht als Astronaut, denn ich interessiere mich für Raketen.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Cool! Was brauchen wir für die Party?</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Musik, Luftballons und etwas zu essen. Meine Mama backt Berliner.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Lecker! Und ich bringe Saft mit.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Wann fängt die Party an?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Um eins, nach dem Unterricht. Und am Ende gibt es einen Kostümwettbewerb!</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%">Und das beste Kostüm bekommt einen Preis?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%">Ja, eine große Torte!</prosody></voice>
</speak>
