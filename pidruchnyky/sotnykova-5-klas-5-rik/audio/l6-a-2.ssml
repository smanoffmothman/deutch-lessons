<speak version="1.0" xmlns="http://www.w3.org/2001/10/synthesis" xml:lang="de-DE">
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Taras, was nimmst du heute?</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Nudeln mit Käse! Das ist mein Lieblingsgericht. Und du?</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Ich mag keine Nudeln. Ich nehme Fisch mit Kartoffeln und einen Salat.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Fisch? Den mag ich gar nicht.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Aber Fisch ist gesund! Und was trinkst du?</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Kakao. Ich trinke jeden Tag Kakao.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Ich trinke lieber Saft, Apfelsaft.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Und zum Nachtisch? Es gibt Kuchen und Obst.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Ich nehme Obst. Ich mag Mandarinen.</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Und ich nehme Kuchen! Schokoladenkuchen mag ich am liebsten.</prosody></voice>
  <voice name="de-DE-KatjaNeural"><prosody rate="-8%" pitch="+10%">Guten Appetit!</prosody></voice>
  <voice name="de-DE-ConradNeural"><prosody rate="-8%" pitch="+12%">Danke, gleichfalls!</prosody></voice>
</speak>
